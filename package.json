{
  "name": "cat-bkn-simulator-generator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "worker": "node --import=tsx --import=dotenv/config scripts/hourlyWorker.ts",
    "worker:force": "node --import=tsx --import=dotenv/config scripts/hourlyWorker.ts --force",
    "worker:status": "node --import=tsx --import=dotenv/config scripts/hourlyWorker.ts --status",
    "worker:reset-keys": "node --import=tsx --import=dotenv/config scripts/hourlyWorker.ts --reset-keys",
    "test:db": "node --import=tsx --import=dotenv/config scripts/testDb.ts"
  },
  "dependencies": {
    "react": "^19.2.3",
    "@google/genai": "^1.34.0",
    "react-dom": "^19.2.3",
    "@neondatabase/serverless": "0.9.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0"
  }
}
